{
  "name": "widgetcomposer-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "contract:generate": "node --import tsx src/spec/export-contract.ts",
    "contract:check": "node --import tsx src/spec/export-contract.ts --check",
    "test": "npm run contract:check && node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@composio/core": "^0.17.0",
    "@prisma/client": "^6.19.3",
    "express": "^5.3.0",
    "express-openapi-validator": "^5.6.2",
    "sharp": "^0.35.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "json-schema-to-typescript": "^15.0.4",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
