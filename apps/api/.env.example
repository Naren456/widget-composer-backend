# Copy to .env and fill in. Never commit .env.

PORT=3000
# Public API base URL for GitHub OAuth callbacks. Use a public HTTPS URL or tunnel when enabling Composio.
PUBLIC_API_URL=http://localhost:3000
# docker compose up -d db  (from the repository root)
DATABASE_URL=postgres://widgetcomposer:widgetcomposer@127.0.0.1:5433/widgetcomposer

# 32 random bytes:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Widget generation. Unset → /v1/widgets/generate answers 503.
# Choose the provider explicitly when configuring more than one key.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Let OpenRouter select an available free model instead of pinning one provider/model.
OPENROUTER_MODEL=openrouter/free
# Google Gemini API (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Free, self-hosted SearXNG search service. No search vendor API key is needed.
# Start the local service with `docker compose up -d searxng`.
SEARXNG_URL=http://127.0.0.1:8080
# If you run the API inside Docker Compose, use: http://searxng:8080
# Set SEARXNG_SECRET in your environment before exposing SearXNG beyond localhost.
# Optional Anthropic fallback/configuration:
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Optional original widget artwork. NVIDIA FLUX.2 Klein 4B is preferred when its key is set.
NVIDIA_API_KEY=
NVIDIA_IMAGE_MODEL=flux.2-klein-4b
NVIDIA_IMAGE_API_URL=https://ai.api.nvidia.com/v1/genai/black-forest-labs/flux.2-klein-4b
# Optional alternative provider.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Set IMAGE_GENERATION_PROVIDER to nvidia, openai, or playwright_chatgpt to override automatic provider selection.
IMAGE_GENERATION_PROVIDER=
PLAYWRIGHT_USER_DATA_DIR=.local/chatgpt-image-profile
# Optional; example on Linux: /usr/bin/google-chrome
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=/usr/bin/google-chrome
PLAYWRIGHT_IMAGE_LIMIT_PER_HOUR=6

# Composio (app.composio.dev → Settings → API keys) connects GitHub and holds its tokens.
# Unset → GitHub connect answers 503 and previews use sample data.
COMPOSIO_API_KEY=
# Optional: a specific GitHub auth config (ac_...). Unset → the project's existing one, or a Composio-managed one.
COMPOSIO_GITHUB_AUTH_CONFIG_ID=
# Contribution charts use authenticated GitHub GraphQL through Composio proxy execution.
# This project key needs proxy_execute access and the GitHub OAuth config needs read:user.
# Where the app is sent after connecting.
APP_REDIRECT_URL=web2widgets://connections

# Browser origins allowed to call the API (Expo web dev server). Native apps need none.
CORS_ORIGINS=http://localhost:8081
